{
  "manifest_version": 3,
  "name": "PlateCheck",
  "version": "1.0.0",
  "description": "Florida restaurant inspection records from official DBPR public data, shown inline for Google Search™ and Google Maps™.",
  "homepage_url": "https://github.com/JolinaJ/PlateCheckFL",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/maps/*"
      ],
      "js": [
        "src/content/index.ts"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": [],
  "host_permissions": [
    "https://www.myfloridalicense.com/*",
    "https://pressagent.envisionconnect.com/*"
  ]
}
