{
  "name": "platecheck-fl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "data:download": "tsx src/ingest/download.ts",
    "data:ingest": "tsx src/ingest/ingest.ts",
    "data:check": "node scripts/check-index-sanity.mjs",
    "data:refresh": "npm run data:download && npm run data:ingest && npm run data:check",
    "data:nyc": "tsx src/ingest/nyc-ingest.ts",
    "data:columbus": "tsx src/ingest/columbus-ingest.ts",
    "data:cincinnati": "tsx src/ingest/cincinnati-ingest.ts",
    "build:columbus": "node scripts/build-region.mjs columbus",
    "build:cincinnati": "node scripts/build-region.mjs cincinnati",
    "build:nyc": "node scripts/build-region.mjs nyc",
    "build:florida": "node scripts/build-region.mjs florida",
    "lookup": "tsx src/lookup/cli.ts",
    "data:fdacs": "tsx src/ingest/fdacs-ingest.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^28.0.3",
    "csv-parse": "^7.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
